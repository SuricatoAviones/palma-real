{
  "name": "palma-real",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo del sistema de gestión del Club Palma Real (backend + frontend)",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r run test",
    "start": "pnpm --filter backend run start"
  }
}